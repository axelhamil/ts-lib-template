{
  "name": "ts-lib-template",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript library template. ESM, tsdown, vitest, biome, release-please. Zero config.",
  "type": "module",
  "license": "MIT",
  "author": "axelhamil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelhamil/ts-lib-template.git"
  },
  "bugs": {
    "url": "https://github.com/axelhamil/ts-lib-template/issues"
  },
  "homepage": "https://github.com/axelhamil/ts-lib-template#readme",
  "keywords": [],
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "!dist/*.map"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && pnpm typecheck",
    "skills": "bash scripts/skills.sh",
    "agents-check": "bash scripts/agents-check.sh",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@vitest/coverage-v8": "^5.0.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
